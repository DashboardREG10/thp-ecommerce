# Supabase Configuration for THP e-Commerce
# Copy this to .env.local (for Vite) or set in hosting platform

# ============================================
# REQUIRED - Get from Supabase Dashboard > Settings > API
# ============================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# OPTIONAL - For Edge Functions / Server-side only
# NEVER expose SERVICE_ROLE_KEY in frontend!
# ============================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# APP SETTINGS
# ============================================
VITE_APP_NAME=THP e-Commerce
VITE_APP_VERSION=1.40